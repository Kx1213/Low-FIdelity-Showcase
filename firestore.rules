rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validPage(pageId) {
      return pageId.size() <= 32
        && (pageId == 'directory'
          || pageId.matches('opportunity-([1-9]|1[0-7])'));
    }

    function validDocumentId(documentId) {
      return documentId.size() >= 1
        && documentId.size() <= 128;
    }

    function anonymousAuthor(data) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && data.authorUid is string
        && data.authorUid == request.auth.uid;
    }

    function validText(text) {
      return text is string
        && text.size() >= 1
        && text.size() <= 2000
        && text.trim().size() > 0;
    }

    function validMessage(data, fields) {
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && anonymousAuthor(data)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.name.trim().size() > 0
        && validText(data.text)
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function validOwnerUpdate(requiredFields, allowedFields) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return anonymousAuthor(resource.data)
        && data.keys().hasAll(requiredFields)
        && data.keys().hasOnly(allowedFields)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.get('deleted', false) is bool
        && (
          // Editing changes only text and the server timestamp.
          // A deleted post must first be restored by its author.
          (changed.hasOnly(['text', 'updatedAt'])
            && resource.data.get('deleted', false) == false
            && data.get('deleted', false) == false
            && validText(data.text))
          ||
          // Delete and Undo toggle the tombstone without replacing the text.
          (changed.hasOnly(['deleted', 'updatedAt'])
            && data.deleted is bool
            && data.deleted != resource.data.get('deleted', false)
            && data.text == resource.data.text)
        );
    }

    function validAnchor(anchor) {
      return anchor is map
        && anchor.keys().hasAll(['exact', 'prefix', 'suffix', 'start', 'end', 'sectionId'])
        && anchor.keys().hasOnly(['exact', 'prefix', 'suffix', 'start', 'end', 'sectionId'])
        && anchor.exact is string
        && anchor.exact.size() >= 1
        && anchor.exact.size() <= 2000
        && anchor.prefix is string
        && anchor.prefix.size() <= 64
        && anchor.suffix is string
        && anchor.suffix.size() <= 64
        && anchor.sectionId is string
        && anchor.sectionId.size() <= 100
        && anchor.start is int
        && anchor.end is int
        && anchor.start >= 0
        && anchor.end > anchor.start
        // Browser Range offsets use UTF-16 units; a Unicode character can use two.
        // Avoid exact String.size() equality so emoji selections remain valid.
        && anchor.end - anchor.start <= 4000;
    }

    match /pageComments/{pageId}/threads/{threadId} {
      allow read: if validPage(pageId);
      allow create: if validPage(pageId)
        && validDocumentId(threadId)
        && validMessage(request.resource.data, ['authorUid', 'name', 'text', 'createdAt', 'anchor'])
        && validAnchor(request.resource.data.anchor);
      allow update: if validPage(pageId)
        && validDocumentId(threadId)
        && validOwnerUpdate(
          ['authorUid', 'name', 'text', 'createdAt', 'anchor'],
          ['authorUid', 'name', 'text', 'createdAt', 'anchor', 'updatedAt', 'deleted']);
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if validPage(pageId);
        allow create: if validPage(pageId)
          && validDocumentId(threadId)
          && validDocumentId(replyId)
          && exists(/databases/$(database)/documents/pageComments/$(pageId)/threads/$(threadId))
          && validMessage(request.resource.data, ['authorUid', 'name', 'text', 'createdAt']);
        allow update: if validPage(pageId)
          && validDocumentId(threadId)
          && validDocumentId(replyId)
          && validOwnerUpdate(
            ['authorUid', 'name', 'text', 'createdAt'],
            ['authorUid', 'name', 'text', 'createdAt', 'updatedAt', 'deleted']);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
